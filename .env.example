# Copy to .env and fill in. Never commit .env.
#
# Rouvr-lite quickstart (ledger :8221 + web workspace :3000) needs only the
# first block below. Everything else is for the full private stack.

# --- Rouvr-lite (required for the quickstart in README.md)
# Random session-signing secret (32+ hex chars). Sessions invalidate on restart without it.
ROUVR_AUTH_SECRET=
# Admin password for the web login (12+ chars). Seeded into the DB on first boot.
ROUVR_ADMIN_PASSWORD=
# Stack token for admin API calls (tenant/project setup, E2E). Any random hex string.
ROUVR_LEDGER_TOKEN=
# Ledger database. Defaults to sqlite:///./.rouvr/ledger.db when unset.
ROUVR_LEDGER_DATABASE_URL=
# Ledger base URL the web app proxies to. Defaults to http://127.0.0.1:8221.
ROUVR_LEDGER_URL=
# Model provider: meta | ollama | openrouter | stub (offline default, no key needed).
ROUVR_MODEL_PROVIDER=stub
# Meta Model API (OpenAI-compatible). Required for live chat plans and seal authoring.
META_API_KEY=
META_MODEL_API_BASE_URL=
META_MODEL_NAME=muse-spark-1.3

# --- Full private stack below (not needed for lite). Settings are read
# with the HYEVE_AIX_SERVICE_ prefix (legacy name, kept for compatibility).

# --- Model provider: meta | ollama | openrouter | stub (offline, default)
ROUVR_MODEL_PROVIDER=stub
# Meta Model API (OpenAI-compatible). No vendor default: set both from your environment.
META_API_KEY=
META_MODEL_API_BASE_URL=
META_MODEL_NAME=
# Open weights via a local OpenAI-compatible server (Ollama/vLLM)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
# Optional
OPENROUTER_API_KEY=

# --- Infrastructure (matches docker-compose.yml)
HYEVE_AIX_SERVICE_DATABASE_URL=postgresql+asyncpg://rouvr:rouvr@localhost:5432/rouvr
HYEVE_AIX_SERVICE_REDIS_URL=redis://localhost:6379/0
HYEVE_AIX_SERVICE_TEMPORAL_ENABLED=true
HYEVE_AIX_SERVICE_TEMPORAL_ADDRESS=localhost:7233
HYEVE_AIX_SERVICE_TEMPORAL_NAMESPACE=default
HYEVE_AIX_SERVICE_WORKHUB_API_URL=http://localhost:8221
HYEVE_AIX_SERVICE_WORKHUB_API_TOKEN=
HYEVE_AIX_SERVICE_OBJECTIVE_CYCLE_WORKSPACE_BASE=/tmp/rouvr/workspaces
HYEVE_AIX_SERVICE_AIX_RUNLOG_ROOT=/tmp/rouvr/runlogs
HYEVE_AIX_SERVICE_ENVIRONMENT=development
HYEVE_AIX_SERVICE_LOG_LEVEL=INFO

# Optional: planner compose file used by the managed-planner bridge
AIX_MANAGED_PLANNER_COMPOSE_FILE=demo/docker-compose.yml

# --- Receipt signing (S010, see docs/configuration.md)
RECEIPT_SIGNING_KEY_PATH=/srv/rouvr/keys/receipt_ed25519.pem
RECEIPT_KEY_ID=rouvr-receipt-1

# --- Rouvr workers (rouvr/config.py Settings.from_env; WORKHUB_BASE_URL and
# --- ROUVR_DATABASE_URL required, no defaults; ROUVR_TENANT_ID defaults to "default")
WORKHUB_BASE_URL=http://127.0.0.1:8221
ROUVR_TENANT_ID=default
ROUVR_DATABASE_URL=postgresql://user:pass@localhost:5432/rouvr

# Rouvr ledger (WorkHub-lite) and demo
ROUVR_LEDGER_URL=http://localhost:8221
ROUVR_LEDGER_DATABASE_URL=sqlite:///./.rouvr/ledger.db
# ROUVR_INJECT=kill_midstep|silent_delivery|revoked_key
