{
  "schema_version": "repo_profile.current",
  "profile_id": "RP-HYEVE-AUTH-PY-FASTAPI-CURRENT",
  "version": 1,
  "repo_patterns": [
    "hyeve-auth-service"
  ],
  "inherits_profile_id": "RP-BASE-PY-CURRENT",
  "command_policy": {
    "allow_prefixes": [
      [
        "python"
      ],
      [
        "pytest"
      ],
      [
        "uv"
      ],
      [
        "git"
      ]
    ],
    "default_timeout_seconds": 45.0,
    "max_timeout_seconds": 180.0
  },
  "default_commands": {
    "test_command": [
      "pytest",
      "-q",
      "services/hyeve-auth-service/tests/test_auth.py"
    ],
    "lint_command": [
      "python",
      "-m",
      "ruff",
      "check",
      "services/hyeve-auth-service/app",
      "services/hyeve-auth-service/tests"
    ],
    "typecheck_command": [
      "python",
      "-m",
      "mypy",
      "services/hyeve-auth-service/app"
    ]
  },
  "drift_guards": {
    "max_files_changed": 20,
    "max_diff_bytes": 500000,
    "blocked_path_prefixes": [
      ".git",
      "secrets",
      "infra/prod"
    ]
  },
  "overlay_policy": {
    "allowed_override_paths": [
      "command_policy.allow_prefixes",
      "command_policy.default_timeout_seconds",
      "drift_guards.max_files_changed",
      "drift_guards.max_diff_bytes",
      "drift_guards.blocked_path_prefixes"
    ]
  },
  "metadata": {
    "language": "python",
    "framework": "fastapi",
    "owner": "auth",
    "instruction_contract": {
      "service_root": "services/hyeve-auth-service",
      "package_root": "app",
      "test_root": "tests",
      "allowed_validation_commands": [
        "pytest tests/test_auth.py -q"
      ]
    }
  }
}
