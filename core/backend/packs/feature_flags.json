  "validation_rules": {
    "deleted_at": {
      "customMessages": {
        "format": "Enter a valid deleted at."
      },
      "format": "date-time",
      "message_keys": {
        "format": "feature_flags.deleted_at.format_date_time"
      }
    },
    "flag_key": {
      "customMessages": {
        "minLength": "Flag Key must be at least 1 characters.",
        "required": "Flag Key is required."
      },
      "message_keys": {
        "minLength": "feature_flags.flag_key.min_length",
        "required": "feature_flags.flag_key.required"
      },
      "minLength": 1,
      "required": true
    }
  },
  "workflows": {
    "create": "feature_flags.create.current",
    "delete": "feature_flags.delete.current",
    "update": "feature_flags.update.current"
  }
