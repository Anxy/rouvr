    "workflows": [
      {
        "failure": {
          "toast": "Failed to create feature flags"
        },
        "id": "feature_flags.create.current",
        "method": "POST",
        "path": "/api/feature-flags",
        "success": {
          "toast": "Feature Flags created"
        },
        "type": "api"
      },
      {
        "id": "feature_flags.update.current",
        "method": "PUT",
        "path": "/api/feature-flags/{id}",
        "success": {
          "toast": "Feature Flags updated"
        },
        "type": "api"
      },
      {
        "id": "feature_flags.delete.current",
        "method": "DELETE",
        "path": "/api/feature-flags/{id}",
        "success": {
          "toast": "Feature Flags deleted"
        },
        "type": "api"
      }
    ]
