generator client {
  provider = "prisma-client-py"
  output   = "generated_prisma/prisma"
  enable_experimental_decimal = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FeatureFlag {
    id              String      @id @default(uuid())
    tenant_id       String
    record_version  Int         @default(1)
    project_id      String?
    flag_key        String
    enabled         Boolean     @default(false)
    rules_json      String?     @default("'{}'::jsonb")
    custom_data     String?     @default("'{}'::jsonb")
    created_at      DateTime    @default(now()) @db.Timestamptz
    updated_at      DateTime    @default(now()) @db.Timestamptz
    created_by      String?
    updated_by      String?
    deleted_at      DateTime?   @db.Timestamptz
}

model CodeIntelRepo {
    id              String      @id @default(uuid())
    tenant_id       String
    record_version  Int         @default(1)
    project_id      String?
    repo_url        String
    registered_at   DateTime    @default(now()) @db.Timestamptz
    created_at      DateTime    @default(now()) @db.Timestamptz
    updated_at      DateTime    @default(now()) @db.Timestamptz
    created_by      String?
    updated_by      String?
    deleted_at      DateTime?   @db.Timestamptz

    @@unique([tenant_id, repo_url])
    @@map("codeintel_repos")
}

model CodeIntelIndexJob {
    id              String      @id @default(uuid())
    repo_id         String
    commit_sha      String
    status          String
    error_class     String?
    created_at      DateTime    @default(now()) @db.Timestamptz
    updated_at      DateTime    @default(now()) @db.Timestamptz

    @@index([repo_id])
    @@map("codeintel_index_jobs")
}

model CodeIntelSnapshot {
    id              String      @id @default(uuid())
    repo_id         String
    commit_sha      String
    snapshot_id     String
    created_at      DateTime    @default(now()) @db.Timestamptz

    @@unique([repo_id, commit_sha])
    @@map("codeintel_snapshots")
}
