  "planner_boundary_cases": [
    {
      "id": "reject_symbol_outside_grounded_target_surface",
      "task_intent": "code_change_required",
      "metadata": {
        "admitted_target_files": [
          "backend/services/workhub_contract_service.py"
        ],
        "prompt_symbol_targets": [
          {
            "relative_path": "backend/services/workhub_contract_service.py",
            "symbol": "WorkhubContractService.create_task"
          }
        ],
        "validation_commands": [
          "python -m pytest backend/tests/test_workhub_contract_service_create_task.py -q"
        ]
      },
      "steps": [
        {
          "tool": "read_range",
          "args": {
            "relative_path": "backend/services/other_service.py",
            "start_line": 1,
            "end_line": 40
          }
        },
        {
          "tool": "confirm_anchor",
          "args": {
            "relative_path": "backend/services/other_service.py",
            "symbol_name": "OtherService.create_task"
          }
        },
        {
          "tool": "edit_file",
          "args": {
            "relative_path": "backend/services/other_service.py",
            "search": "def create_task(self):\n    return {}\n",
            "replace": "def create_task(self):\n    return {'ok': False}\n"
          }
        },
        {
          "tool": "cmd.run",
          "args": {
            "command": [
              "python",
              "-m",
              "pytest",
              "backend/tests/test_workhub_contract_service_create_task.py",
              "-q"
            ]
          }
        }
      ],
      "expected": {
        "validation_error": "PLANNER_SYMBOL_OUTSIDE_GROUNDED_TARGETS"
      }
    },
    {
      "id": "accept_fully_qualified_symbol_equivalent_to_grounded_target",
