  "candidate_safety_cases": [
    {
      "id": "validation_attached_under_tests_commands",
      "task_intent": "code_change_required",
      "metadata": {
        "target_files": [
          "app/main.py"
        ],
        "validation_commands": [
          "pytest tests/test_auth.py -q"
        ]
      },
      "instruction_contract": {},
      "evidence": {
        "changed_files": [
          "app/main.py"
        ],
        "commands": [],
        "tests": {
          "detected": true,
          "commands": [
            {
              "command": [
                "pytest",
                "tests/test_auth.py",
                "-q",
                "--tb=short"
              ],
              "stdout": ".                                                                        [100%]\n1 passed in 0.20s\n",
              "returncode": 0
            }
          ]
        }
      },
      "expected": {
        "status": "accepted",
        "executed_commands": [
          "pytest tests/test_auth.py -q --tb=short"
        ]
      }
    },
