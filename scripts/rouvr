#!/usr/bin/env bash
# Single command to launch the whole Rouvr stack and use it:
#   ./scripts/rouvr            # start everything, then open the supervisor muse chat
#   ./scripts/rouvr --no-chat  # start everything only (no supervisor session)
#   ./scripts/rouvr status     # health of every piece
#   ./scripts/rouvr stop       # stop workers/MCP/ledger (Temporal stack stays; `down` stops it too)
#   ./scripts/rouvr down       # stop everything including the Docker Temporal stack
#
# Stack: Temporal (Docker, 7233) + ledger WorkHub (8221) + MCP front door (8231)
# + 4 background workers (orch/build/test/verify). Coder/reviewer turns open as
# interactive muse chat windows (ROUVR_LAUNCH_WINDOWS=0 for headless).
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OPS="${ROUVR_OPS_DIR:-/tmp/rouvr-supervisor}"
PID_DIR="$OPS/pids"
OVERRIDE=/tmp/rouvr-override.yml
cd "$ROOT"

write_override() {
  cat > "$OVERRIDE" <<'EOF'
services:
  db:
    ports: !override ["5433:5432"]
  redis:
    ports: !override ["6380:6379"]
  temporal:
    ports: !override ["7233:7233"]
  temporal-ui:
    ports: !override ["8081:8080"]
  ledger:
    ports: !override ["8221:8221"]
EOF
}

write_operands() {
  mkdir -p "$OPS/personas" "$OPS/specs/supervisor" "$OPS/workspaces" "$OPS/evidence" "$OPS/hidden-tests" "$OPS/logs" "$OPS/keys"
  local ws="${ROUVR_PERSONA_CREDS_DIR:-$HOME/Repository/hackathon/.secrets/rouvr/personas}"
  [ -f "$OPS/personas/tenants.yaml" ] || cat > "$OPS/personas/tenants.yaml" <<EOF
tenants:
  supervisor:
    personas:
      coder-1: {role: coder, principal: svc-sup-coder, muse_model: "", credential_file: "$ws/coder-1.json", github_app: supervisor}
      reviewer-1: {role: reviewer, principal: svc-sup-reviewer, muse_model: "", credential_file: "$ws/reviewer-1.json"}
EOF
  if [ -n "${ROUVR_PERSONA_CREDS_DIR:-}" ] && [ -f "$OPS/personas/tenants.yaml" ]; then
    sed -i "s|credential_file: \"[^\"]*/\([^/\"]*\)\"|credential_file: \"$ws/\1\"|g; s|credential_file: [^ \"',}]*/\([^ \"',}]*\)|credential_file: $ws/\1|g" "$OPS/personas/tenants.yaml"
  fi
  for md in coder.md reviewer.md; do
    [ -f "$OPS/personas/$md" ] || cp "$ROOT/personas/$md" "$OPS/personas/$md"
  done
  [ -f "$OPS/specs/supervisor/scratch.yaml" ] || cat > "$OPS/specs/supervisor/scratch.yaml" <<'EOF'
repo: ebiz-backend-developer/rouvr-r10-scratch
base_branch: main
test_command: ["python", "-m", "pytest", "-q"]
timeout_s: 900
EOF
  if [ ! -f "$OPS/api-token" ]; then
    (umask 077; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$OPS/api-token")
  fi
  if [ ! -f "$OPS/keys/receipt_ed25519.pem" ]; then
    (umask 077; RECEIPT_KEY_PATH="$OPS/keys/receipt_ed25519.pem" .venv/bin/python -c "
import os
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
from cryptography.hazmat.primitives.serialization import Encoding, NoEncryption, PrivateFormat
p = os.environ['RECEIPT_KEY_PATH']
open(p, 'wb').write(Ed25519PrivateKey.generate().private_bytes(Encoding.PEM, PrivateFormat.PKCS8, NoEncryption()))
os.chmod(p, 0o600)
")
  fi
  cat > "$OPS/env.sh" <<EOF
export WORKHUB_BACKEND=ledger WORKHUB_BASE_URL=http://127.0.0.1:8221 ROUVR_TENANT_ID=supervisor ROUVR_PROJECT_ID=scratch PERSONA_SOURCE=yaml PERSONA_REGISTRY_PATH=$OPS/personas/tenants.yaml SPEC_ROOT=$OPS/specs WORKSPACE_ROOT=$OPS/workspaces EVIDENCE_ROOT=$OPS/evidence HIDDEN_TESTS_ROOT=$OPS/hidden-tests TEMPORAL_ADDRESS=127.0.0.1:7233 TEMPORAL_NAMESPACE=default ORCHESTRATOR_TOKEN=ledger LEASE_TTL_S=180 HEARTBEAT_S=30 MAX_REWORK=2 MUSE_BIN=muse
export ROUVR_LEDGER_TOKEN="\$(cat $OPS/api-token)"
export RECEIPT_SIGNING_KEY_PATH=$OPS/keys/receipt_ed25519.pem
EOF
}

load_env() {
  write_operands
  set -a; . "$OPS/env.sh"; set +a
  export PYTHONPATH="$ROOT"
  export META_MODEL_API_KEY="${META_MODEL_API_KEY:-$(grep -E '^META_MODEL_API_KEY=' .env | cut -d= -f2-)}"
  export GH_TOKEN="${GH_TOKEN:-$(gh auth token 2>/dev/null || true)}"
  export ROUVR_LAUNCH_WINDOWS="${ROUVR_LAUNCH_WINDOWS:-1}"
}

# Checkout-scoped process tracking: pids started here are recorded in
# $PID_DIR, and a pid only counts as ours when /proc shows it runs from
# $ROOT (another checkout's workers on the same box are never touched).
_ours() {
  local pid="${1:-}"
  [ -n "$pid" ] && [ -d "/proc/$pid" ] || return 1
  [ "$(readlink "/proc/$pid/cwd" 2>/dev/null)" = "$ROOT" ] && return 0
  tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -qF "$ROOT/"
}

_pid_alive() {  # $1 = name: pidfile holds a live pid of this checkout
  local f="$PID_DIR/$1.pid" pid=""
  [ -f "$f" ] || return 1
  pid="$(cat "$f" 2>/dev/null)" || return 1
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && _ours "$pid"
}

_adopt() {  # $1 = name, $2 = pgrep pattern: record a running own-checkout pid
  local pid
  for pid in $(pgrep -f "$2" || true); do
    if _ours "$pid"; then mkdir -p "$PID_DIR"; echo "$pid" >"$PID_DIR/$1.pid"; return 0; fi
  done
  return 1
}

_start() {  # $1 = name, $2 = log, rest = command: detached, pid recorded
  local name="$1" log="$2"; shift 2
  mkdir -p "$PID_DIR"
  setsid -f bash -c 'echo $$ >"$1"; shift; exec "$@"' _ "$PID_DIR/$name.pid" "$@" >>"$log" 2>&1
}

up() {
  write_override; load_env
  echo "[rouvr] Temporal stack (Docker)..."
  docker compose -p rouvr -f demo/docker-compose.yml -f "$OVERRIDE" up -d db redis temporal >/dev/null
  local temporal_ok=0
  for _ in $(seq 1 30); do
    .venv/bin/python -c "
import asyncio
from temporalio.client import Client
asyncio.run(Client.connect('127.0.0.1:7233', namespace='default'))" 2>/dev/null && { temporal_ok=1; break; }; sleep 2
  done
  [ "$temporal_ok" = "1" ] || { echo "[rouvr] ERROR: Temporal did not answer on 7233; aborting up" >&2; exit 1; }
  echo "[rouvr] ledger WorkHub (8221)..."
  if curl -sf http://127.0.0.1:8221/health >/dev/null 2>&1; then
    _pid_alive ledger || _adopt ledger 'ledger[.]app' || { echo "[rouvr] ERROR: port 8221 answered by a foreign process (not this checkout $ROOT); aborting up" >&2; exit 1; }
  else
    _start ledger "$OPS/logs/ledger.log" env ROUVR_LEDGER_DATABASE_URL="sqlite:///$OPS/ledger.db" .venv/bin/python -c "
from ledger.app import make_app
import os, uvicorn
uvicorn.run(make_app(os.environ['ROUVR_LEDGER_DATABASE_URL']), host='127.0.0.1', port=8221, log_level='warning')
"
    for _ in $(seq 1 10); do curl -sf http://127.0.0.1:8221/health >/dev/null 2>&1 && break; sleep 1; done
    curl -sf http://127.0.0.1:8221/health >/dev/null 2>&1 || { echo "[rouvr] ERROR: ledger did not answer /health; aborting up (see $OPS/logs/ledger.log)" >&2; exit 1; }
  fi
  echo "[rouvr] WorkHub MCP plugin (bundled; no manual MCP setup)..."
  if ! muse plugins list --json 2>/dev/null | grep -q '"rouvr-workhub"'; then
    muse plugins install "$ROOT/plugin" --scope user --json >/dev/null 2>&1 || \
      echo "[rouvr] WARN: plugin install failed; run 'muse plugins install $ROOT/plugin --scope user' once"
  fi
  muse plugins approve rouvr-workhub --json >/dev/null 2>&1 || true
  echo "[rouvr] workers + MCP (8231)..."
  for q in orch build test verify; do
    _pid_alive "worker-$q" || _adopt "worker-$q" "rouvr[.]worker $q" || \
      _start "worker-$q" "$OPS/logs/$q.log" .venv/bin/python -m rouvr.worker "$q"
  done
  sleep 2  # S012: second pass — a worker dying during start has a pidfile once, then is gone
  for q in orch build test verify; do
    _pid_alive "worker-$q" || _start "worker-$q" "$OPS/logs/$q.log" .venv/bin/python -m rouvr.worker "$q"
  done
  # Port check, not pidfile: a dying MCP still has a pidfile briefly and
  # would make us skip the start, leaving no server once it exits.
  _pid_alive mcp || _adopt mcp 'rouvr[.]mcp_server' || true
  if curl -s -m 2 http://127.0.0.1:8231/mcp >/dev/null 2>&1; then
    _pid_alive mcp || { echo "[rouvr] ERROR: port 8231 answered by a foreign process (not this checkout $ROOT); aborting up" >&2; exit 1; }
  else
    _start mcp "$OPS/logs/mcp.log" .venv/bin/python -m rouvr.mcp_server
    for _ in $(seq 1 10); do curl -s -m 2 http://127.0.0.1:8231/mcp >/dev/null 2>&1 && break; sleep 1; done
    curl -s -m 2 http://127.0.0.1:8231/mcp >/dev/null 2>&1 || { echo "[rouvr] ERROR: MCP did not answer on 8231; aborting up (see $OPS/logs/mcp.log)" >&2; exit 1; }
  fi
  sleep 5
  status
  cat <<'EOF'

Use Rouvr:
  The WorkHub MCP tools are bundled via the rouvr-workhub Muse plugin
  (auto-installed above) — no manual MCP setup. The supervisor muse
  session opens automatically below (SUPERVISOR.md persona); chat normally:
       "Create a task to <change> with criteria <...> and start it."
     The supervisor delivers it to WorkHub via MCP; coder/reviewer muse chat
     windows open on your screen and loop until the task is done.
  Watch:  ./scripts/rouvr status   |   tasks: curl -s http://127.0.0.1:8221/v1/tasks
EOF
  if [ "$CHAT" = "1" ] && [ -t 0 ]; then
    local ws="${ROUVR_SUPERVISOR_WORKSPACE:-$ROOT}"
    echo "[rouvr] opening supervisor muse session in $ws (exit the chat to return; stack keeps running)..."
    if [ -n "${ROUVR_ACTIVE_USER:-}" ]; then
      # Only the supervisor session carries the user token; workers/MCP
      # keep the stack identity (S016 AC-5).
      exec env ROUVR_LEDGER_TOKEN="$ROUVR_PROFILE_TOKEN" ROUVR_USER="$ROUVR_ACTIVE_USER" \
        muse --workspace "$ws" "You are the Rouvr supervisor, supervising as user '$ROUVR_ACTIVE_USER'. Read $ROOT/SUPERVISOR.md now and follow it for the whole session. The full stack is already running: ledger WorkHub, Temporal workers, and your bundled rouvr-workhub MCP tools. Greet the user briefly and ask what task to deliver."
    fi
    exec muse --workspace "$ws" "You are the Rouvr supervisor. Read $ROOT/SUPERVISOR.md now and follow it for the whole session. The full stack is already running: ledger WorkHub, Temporal workers, and your bundled rouvr-workhub MCP tools. Greet the user briefly and ask what task to deliver."
  fi
}

status() {
  echo "user:     ${ROUVR_ACTIVE_USER:-stack (supervisor)}"
  echo "temporal: $(.venv/bin/python -c "
import asyncio
from temporalio.client import Client
try:
    asyncio.run(Client.connect('127.0.0.1:7233', namespace='default')); print('up')
except Exception: print('DOWN')" 2>/dev/null)"
  echo "ledger:   $(curl -s http://127.0.0.1:8221/health 2>/dev/null || echo DOWN)"
  echo "mcp:      http://127.0.0.1:8231/mcp ($(_pid_alive mcp && echo 1 || echo 0) proc)"
  local _wn=0 _q
  for _q in orch build test verify; do _pid_alive "worker-$_q" && _wn=$((_wn + 1)) || true; done
  echo "workers:  $_wn/4 queues"
  echo "tasks:    $(curl -s -H "X-Rouvr-Token: ${ROUVR_LEDGER_TOKEN:-}" http://127.0.0.1:8221/v1/tasks 2>/dev/null | .venv/bin/python -c "
import json, sys
try: print([(t['id'], t['state']) for t in json.load(sys.stdin)['items']])
except Exception: print('n/a')" 2>/dev/null)"
}

_kill_matching() {  # $1 = pgrep pattern: kill every own-checkout match, not just the first
  local pid
  for pid in $(pgrep -f "$1" || true); do
    if _ours "$pid"; then kill "$pid" 2>/dev/null || true; fi
  done
}

stop() {
  local name f pid q
  _kill_matching 'ledger[.]app'
  _kill_matching 'rouvr[.]mcp_server'
  for q in orch build test verify; do _kill_matching "rouvr[.]worker $q"; done
  _adopt ledger 'ledger[.]app' || true
  _adopt mcp 'rouvr[.]mcp_server' || true
  for q in orch build test verify; do _adopt "worker-$q" "rouvr[.]worker $q" || true; done
  for name in worker-orch worker-build worker-test worker-verify mcp ledger; do
    f="$PID_DIR/$name.pid"
    [ -f "$f" ] || continue
    pid="$(cat "$f" 2>/dev/null)" || pid=""
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$f"  # stale pidfile
    elif [ -n "$pid" ] && _ours "$pid"; then
      kill "$pid" 2>/dev/null || true
      rm -f "$f"
    fi
    # a live pid from another checkout keeps its process and its pidfile
  done
  echo "[rouvr] workers/MCP/ledger stopped (Temporal stack left running; './scripts/rouvr down' stops it)"
}

down() {
  stop
  write_override
  docker compose -p rouvr -f demo/docker-compose.yml -f "$OVERRIDE" down >/dev/null 2>&1 || true
  echo "[rouvr] Docker Temporal stack stopped"
}

reap() {  # kill persona windows whose task is done/blocked/gone (auto-runs every 30s in MCP too)
  load_env >/dev/null 2>&1 || true
  .venv/bin/python -c "
from rouvr.mcp_server import _reap_stale
out = _reap_stale()
print(f\"killed {len(out['killed'])} stale window(s): {out['killed']}\")
print(f\"kept {len(out['kept'])} in-flight window(s): {out['kept']}\")"
}

# ---- S016 user profiles -------------------------------------------------
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/rouvr"
if [ "${1:-}" = "user" ]; then
  case "${2:-}" in
    add) shift 2; exec "$ROOT/scripts/seed-user" "$@" ;;
    list)
      for f in "$CONF"/users/*.json; do
        [ -e "$f" ] || continue
        n="$(basename "$f" .json)"
        [ -f "$CONF/default-user" ] && [ "$(cat "$CONF/default-user")" = "$n" ] && echo "$n (default)" || echo "$n"
      done ;;
    use) [ -n "${3:-}" ] || { echo "usage: rouvr user use <username>" >&2; exit 2; }
         mkdir -p "$CONF"; printf %s "$3" > "$CONF/default-user"; echo "default user: $3" ;;
    *) echo "usage: rouvr user add|list|use <username>" >&2; exit 2 ;;
  esac
  exit 0
fi

# Optional leading --user <name>: select that profile for this launch.
ARGS=()
while [ $# -gt 0 ]; do
  if [ "$1" = "--user" ]; then ROUVR_ACTIVE_USER="${2:-}"; shift 2; else ARGS+=("$1"); shift; fi
done
set -- "${ARGS[@]:-}"
if [ -z "${ROUVR_ACTIVE_USER:-}" ] && [ -f "$CONF/default-user" ]; then
  ROUVR_ACTIVE_USER="$(cat "$CONF/default-user")"
fi
if [ -n "${ROUVR_ACTIVE_USER:-}" ]; then
  PF="$CONF/users/$ROUVR_ACTIVE_USER.json"
  if [ ! -f "$PF" ]; then
    if [ -t 0 ]; then
      printf "No profile for '%s'. Create it now? [Y/n] " "$ROUVR_ACTIVE_USER"
      read -r ans; case "$ans" in n|N) exit 2;; *) "$ROOT/scripts/seed-user" "$ROUVR_ACTIVE_USER";; esac
    else
      echo "no profile for '$ROUVR_ACTIVE_USER'; run: rouvr user add $ROUVR_ACTIVE_USER" >&2; exit 2
    fi
  fi
  [ "$(stat -c %a "$PF")" = "600" ] || { echo "profile $PF must be mode 600 (chmod 600)" >&2; exit 2; }
  ROUVR_PROFILE_TOKEN="$("$ROOT/.venv/bin/python" -c "import json,sys; print(json.load(open(sys.argv[1]))['token'])" "$PF")"
  export ROUVR_ACTIVE_USER
fi

CHAT=1
[ "${2:-}" = "--no-chat" ] && CHAT=0
case "${1:-up}" in
  up) up ;;
  --no-chat) CHAT=0; up ;;
  status) load_env >/dev/null 2>&1 || true; status ;;
  reap) reap ;;
  stop) stop ;;
  down) down ;;
  *) echo "usage: ./scripts/rouvr [--no-chat|status|reap|stop|down]" >&2; exit 2 ;;
esac
