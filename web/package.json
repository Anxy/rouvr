{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:api": "GEN_PY=python3; if test -x ../.venv/bin/python; then GEN_PY=../.venv/bin/python; fi; $GEN_PY ../scripts/export_openapi.py && node --import ./scripts/ts6-hook.mjs ./node_modules/openapi-typescript/bin/cli.js ./src/lib/api/openapi.json -o ./src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "clsx": "^2.1.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "^7.4.0",
    "tailwindcss": "^4",
    "typescript": "^7"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
}
