    "/v1/knowledge/search": {
      "get": {
        "description": "Shortlist search: top N (default 15) as slug/title/kind/summary/\nverified/citation only; full=true returns whole rows. Retrieval:\nporter-stemmed prefix FTS plus an FTS5 trigram index (partials,\nsubstrings, typo candidates); the pooled top ~50 are re-ranked\nwith RapidFuzz WRatio over title/slug/tags/summary, and every run\nmerges by reciprocal rank fusion. A sqlite-vec + fastembed\nsemantic run plugs in at _semantic_candidates (D18, not built:\nhonest stub, contributes nothing). Verified entries get one extra\nrank-1 RRF vote, so human-confirmed knowledge surfaces above\nunverified near-ties. Tenant/visibility filters\napply to every candidate.",
        "operationId": "search_knowledge_v1_knowledge_search_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "project",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Project"
            }
          },
          {
            "in": "query",
            "name": "n",
            "required": false,
            "schema": {
              "default": 15,
              "title": "N",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "full",
            "required": false,
            "schema": {
              "default": false,
              "title": "Full",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Knowledge"
      }
    },
